{
  "name": "deveye-feature-counter",
  "version": "0.1.0",
  "description": "DevEye feature template: a shared counter with one big button, a server-side increment, and a journal showing each value plain and encrypted.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./client": "./src/client/index.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "assets",
    "deveye-feature.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "validate": "tsx scripts/validate.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run validate && npm run test"
  },
  "peerDependencies": {
    "@deveye/types": ">=0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.0.0",
    "@deveye/types": "^0.17.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "react": "^19.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.39.0",
    "zod": "^4.4.0",
    "@types/node": "^22.0.0"
  }
}
